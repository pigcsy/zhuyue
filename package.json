    "material-design-icons": "^3.0.1",
    "vue": "^2.5.21",
    "vue-axios": "^2.1.4",
    "vue-router": "^3.0.2",
    "vue-wechat-title": "^2.0.5",
    "vue-ydui": "^1.2.6",
    "vuex": "^3.0.1"
  },
  "devDependencies": {
